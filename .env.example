# StringsAttached — environment configuration
#
# Copy this file to `.env` (for the frontend build) and to `backend/.env`
# (for the backend) and fill in values as needed.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Google Gemini API key. Server-side only — NEVER expose it to the browser.
# The application still runs (local tracking/measurement) without it, but
# Gemini coaching will report "GEMINI UNAVAILABLE" and fall back to a clearly
# labeled deterministic cue.
GEMINI_API_KEY=

# Gemini model used for coaching interpretation.
# GEMINI_MODEL=gemini-2.0-flash

# Ephemeral session token lifetime (seconds). The browser exchanges a session
# id for a short-lived token; permanent credentials never leave the backend.
# SESSION_TOKEN_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Frontend (optional build-time configuration)
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend. Defaults to same-origin (/api), which works
# when the backend proxies the frontend or when Vite proxies /api.
# VITE_BACKEND_URL=/api

# Allow connecting the frontend to a backend on another origin.
# VITE_API_ORIGIN=http://localhost:8000

{
  "name": "stringsattached",
  "private": true,
  "version": "2.0.0",
  "description": "StringsAttached — AI motor-skill coaching (ukulele, basketball, squats). Camera-based, measurement-driven, Gemini-coached.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:templates": "tsx scripts/generate-chord-templates.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "tsx": "^4.19.2"
  }
}
